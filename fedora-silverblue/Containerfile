RUN --mount=type=cache,dst=/var/cache/ \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    dnf5 remove $DNF_ARGS $DNF_REMOVE

RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    dnf5 install $DNF_ARGS https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm

RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    sudo rpm --import https://packages.microsoft.com/keys/microsoft.asc && \
    sudo dnf $DNF_ARGS config-manager addrepo \
      --id=code \
      --save-filename=vscode \
      --set=name="Visual Studio Code" \
      --set=baseurl=https://packages.microsoft.com/yumrepos/vscode \
      --set=enabled=1 \
      --set=gpgcheck=1 \
      --set=gpgkey=https://packages.microsoft.com/keys/microsoft.asc

RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    sudo dnf $DNF_ARGS config-manager addrepo \
      --id=netbird \
      --save-filename=netbird \
      --set=name="netbird" \
      --set=baseurl=https://pkgs.netbird.io/yum/ \
      --set=enabled=1 \
      --set=gpgcheck=1 \
      --set=repo_gpgcheck=1 \
      --set=gpgkey=https://pkgs.netbird.io/yum/repodata/repomd.xml.key

