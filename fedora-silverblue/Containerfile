# Download the rest from extensions.gnome.org
RUN set -eux; \
    SHELL_VER=$(gnome-shell --version | grep -oP '\d+' | head -1); \
    for UUID in ${GEXT}; do \
      case "$UUID" in *gcampax*) continue;; esac; \
      DL=$(curl -fsSL "https://extensions.gnome.org/extension-info/?uuid=${UUID}&shell_version=${SHELL_VER}" \
           | python3 -c 'import sys,json; print(json.load(sys.stdin)["download_url"])'); \
      DEST="/usr/share/gnome-shell/extensions/${UUID}"; \
      mkdir -p "$DEST"; \
      curl -fsSL "https://extensions.gnome.org${DL}" -o /tmp/ext.zip; \
      unzip -q -o /tmp/ext.zip -d "$DEST"; \
      rm /tmp/ext.zip; \
      chmod -R u=rwX,go=rX /usr/share/gnome-shell/extensions/; \
      if [ -d "$DEST/schemas" ]; then glib-compile-schemas "$DEST/schemas"; fi; \
    done

# Enable them by default for all users
RUN set -eux; \
    mkdir -p /etc/dconf/db/local.d; \
    LIST=$(printf "'%s'," ${GEXT} | sed 's/,$//'); \
    printf "[org/gnome/shell]\nenabled-extensions=[%s]\n" "$LIST" > /etc/dconf/db/local.d/00-extensions; \
    dconf update


