RUN --mount=type=cache,dst=/var/cache/ \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    dnf5 install $DNF_ARGS rpmfusion-\*-appstream-data

RUN --mount=type=cache,dst=/var/cache/ \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    dnf5 config-manager $DNF_ARGS setopt fedora-cisco-openh264.enabled=1

ARG DNF_COPRS

RUN --mount=type=cache,dst=/var/cache/ \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    for copr in $DNF_COPRS; do \
        dnf5 $DNF_ARGS copr enable "$copr"; \
    done

ARG DNF_COPR_PACKAGES DNF_BASE 

RUN --mount=type=cache,dst=/var/cache/ \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    mkdir -p /var/opt /usr/lib/opt && \
    mkdir -p /usr/lib/tmpfiles.d && \
    dnf5 $DNF_ARGS install --allowerasing $DNF_BASE $DNF_COPR_PACKAGES && \
    for dir in /var/opt/*/; do \
        [ -d "$dir" ] || continue; \
        name=$(basename "$dir"); \
        mv "$dir" "/usr/lib/opt/$name"; \
        echo "L+ /var/opt/$name - - - - /usr/lib/opt/$name" \
            >> /usr/lib/tmpfiles.d/opt-fix.conf; \
    done


RUN desktop-file-edit --set-key=NoDisplay --set-value=true /usr/share/applications/htop.desktop
RUN desktop-file-edit --set-key=NoDisplay --set-value=true /usr/share/applications/java-25-openjdk-jconsole.desktop
RUN desktop-file-edit --set-key=NoDisplay --set-value=true /usr/share/applications/java-latest-openjdk-jconsole.desktop

ARG DNF_LATEX 

RUN --mount=type=cache,dst=/var/cache/ \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    dnf5 install $DNF_ARGS \
        --setopt=tsflags=nodocs \
         $DNF_LATEX

RUN --mount=type=cache,dst=/var/cache/ \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    dnf5 install $DNF_ARGS \
        netbird netbird-ui network-manager-netbird || true  && \
    rpm -q netbird netbird-ui network-manager-netbird

