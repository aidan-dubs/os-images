FROM quay.io/fedora/fedora-iot:45 as base

ARG DNF_REMOVE DNF_COPRS DNF_COPR_PACKAGES DNF_BASE DNF_LATEX DNF_FROM_URL GNOME_EXTENSIONS

ARG DNF_ARGS="--assumeyes --setopt=keepcache=1 --setopt=max_parallel_downloads=20"

RUN echo -e "max_parallel_downloads=20" >> /etc/dnf/dnf.conf

RUN --mount=type=cache,dst=/var/cache/ \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    dnf5 remove $DNF_ARGS $DNF_REMOVE

RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    dnf5 install $DNF_ARGS https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm

RUN --mount=type=cache,dst=/var/cache/ \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    dnf5 $DNF_ARGS config-manager addrepo --from-repofile=https://pkgs.tailscale.com/stable/fedora/tailscale.repo

RUN --mount=type=cache,dst=/var/cache/ \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    dnf5 config-manager $DNF_ARGS setopt fedora-cisco-openh264.enabled=1


RUN --mount=type=cache,dst=/var/cache/ \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    for copr in $DNF_COPRS; do \
        dnf5 $DNF_ARGS copr enable "$copr"; \
    done

RUN --mount=type=cache,dst=/var/cache/ \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    dnf5 $DNF_ARGS install --allowerasing $DNF_BASE $DNF_COPR_PACKAGES

RUN --mount=type=cache,dst=/var/cache/ \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    dnf5 install $DNF_ARGS \
        --setopt=tsflags=nodocs \
         $DNF_FROM_URL

COPY --from=cosign cosign.pub /etc/pki/containers/forgejo.pub

ARG REGISTRY
ARG UNTAGGED_IMAGE

RUN --mount=type=secret,id=ostree-auth,target=/tmp/ostree-auth.json \
    install -D -m 0600 /tmp/ostree-auth.json /etc/ostree/auth.json

RUN cat << EOF > /etc/containers/policy.json
{
  "default": [{ "type": "insecureAcceptAnything" }],
  "transports": {
    "docker": {
      "${UNTAGGED_IMAGE}": [
        {
          "type": "insecureAcceptAnything"
        }
      ]
    },
    "docker-daemon": { "": [{ "type": "insecureAcceptAnything" }] }
  }
}
EOF

RUN cat /etc/containers/policy.json

RUN mkdir -p /etc/containers/registries.d && cat << EOF > /etc/containers/registries.d/forgejo.yaml
docker:
  ${REGISTRY}:
    use-sigstore-attachments: true
EOF

run cat /etc/containers/registries.d/forgejo.yaml

RUN bootc container lint

FROM base AS nvidia

RUN --mount=type=cache,dst=/var/cache/ \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    KVER="$(rpm -q kernel-core --qf '%{VERSION}-%{RELEASE}.%{ARCH}')" && \
    dnf5 install $DNF_ARGS --setopt=tsflags=noscripts akmod-nvidia xorg-x11-drv-nvidia-cuda  "kernel-devel-${KVER}" && \
    akmods --force --kernels "${KVER}" && \
    modinfo -k "${KVER}" nvidia > /dev/null && \
    dracut --no-hostonly --kver "${KVER}" --reproducible --add ostree -f "/usr/lib/modules/${KVER}/initramfs.img"


RUN --mount=type=cache,dst=/var/cache/ \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    dnf5 config-manager addrepo $DNF_ARGS \
    --from-repofile=https://nvidia.github.io/libnvidia-container/stable/rpm/nvidia-container-toolkit.repo

RUN --mount=type=cache,dst=/var/cache/ \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    dnf5 install $DNF_ARGS \
        nvidia-container-toolkit \
        nvidia-container-toolkit-base \
        libnvidia-container-tools \
        libnvidia-container1

RUN install -Dm644 /dev/stdin /usr/lib/bootc/kargs.d/00-nvidia.toml <<'EOF'
kargs = ["rd.driver.blacklist=nouveau", "modprobe.blacklist=nouveau", "nvidia-drm.modeset=1" , "nvidia-drm.fbdev=1"]
EOF

RUN bootc container lint

FROM base AS nvidia-legacy

RUN --mount=type=cache,dst=/var/cache/ \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
