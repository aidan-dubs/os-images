FROM quay.io/fedora/fedora-bootc:45

ARG DNF_ARGS="--assumeyes --setopt=max_parallel_downloads=20"

RUN dnf5 $DNF_ARGS install podman image-builder git curl jq gnupg2 which && dnf clean all

# RUN export ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/'); \
#     export RUNNER_VERSION=$(curl -X 'GET' https://data.forgejo.org/api/v1/repos/forgejo/runner/releases/latest | jq .name -r | cut -c 2-); \
#     export FORGEJO_URL="https://code.forgejo.org/forgejo/runner/releases/download/v${RUNNER_VERSION}/forgejo-runner-${RUNNER_VERSION}-linux-${ARCH}"; \
#     wget -O forgejo-runner ${FORGEJO_URL} || curl -o forgejo-runner ${FORGEJO_URL}; \
#     chmod +x forgejo-runner; \
#     wget -O forgejo-runner.asc ${FORGEJO_URL}.asc || curl -o forgejo-runner.asc ${FORGEJO_URL}.asc; \
#     gpg --keyserver hkps://keys.openpgp.org --recv EB114F5E6C0DC2BCDD183550A4B61A2DC5923710; \
#     gpg --verify forgejo-runner.asc forgejo-runner && echo "✓ Verified" || echo "✗ Failed"; \
#     mv forgejo-runner /usr/local/bin/forgejo-runner

RUN groupadd --system podman-socket \
 && useradd --create-home --groups podman-socket runner

RUN mkdir -p /etc/systemd/system/podman.socket.d \
 && printf '[Socket]\nSocketGroup=podman-socket\nSocketMode=0660\nDirectoryMode=0755\n' \
      > /etc/systemd/system/podman.socket.d/10-group.conf

RUN systemctl enable podman.socket

# RUN loginctl enable-linger runner

# COPY ./forgejo-runner.service /etc/systemd/system/forgejo-runner.service

COPY --from=cosign cosign.pub /etc/pki/containers/forgejo.pub


ARG REGISTRY
ARG UNTAGGED_IMAGE

RUN cat << EOF > /etc/containers/policy.json
{
  "default": [{ "type": "insecureAcceptAnything" }],
  "transports": {
    "docker": {
      "${UNTAGGED_IMAGE}": [
        {
          "type": "sigstoreSigned",
          "keyPath": "/etc/pki/containers/forgejo.pub",
          "signedIdentity": { "type": "matchRepository" }
        }
      ]
    },
    "docker-daemon": { "": [{ "type": "insecureAcceptAnything" }] }
  }
}
EOF

RUN mkdir -p /etc/containers/registries.d && cat << EOF > /etc/containers/registries.d/forgejo.yaml
docker:
  ${REGISTRY}:
    use-sigstore-attachments: true
EOF

RUN bootc container lint
