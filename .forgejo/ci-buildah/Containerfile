FROM quay.io/containers/buildah:v1.46

RUN dnf install -y nodejs git yq && dnf clean all && rm -rf /var/cache/libdnf5/*

# Image builder tries to chcon even when it doesn't need to
# RUN printf '#!/bin/sh\nexit 0\n' > /usr/bin/chcon && chmod +x /usr/bin/chcon

COPY ./storage.conf /etc/containers/storage.conf

RUN set -eux; \
    LATEST_VERSION="$(curl -fsSL https://api.github.com/repos/sigstore/cosign/releases/latest | grep tag_name | cut -d '"' -f 4 | sed 's/^v//')"; \
    curl -fsSL -o /tmp/cosign.rpm "https://github.com/sigstore/cosign/releases/download/v${LATEST_VERSION}/cosign-${LATEST_VERSION}-1.x86_64.rpm"; \
    dnf install -y --nogpgcheck /tmp/cosign.rpm; \
    rm -f /tmp/cosign.rpm
