FROM quay.io/containers/buildah:v1.43
USER root

RUN dnf remove -y fuse-overlayfs && dnf install -y nodejs git yq image-builder && dnf clean all && rm -rf /var/cache/libdnf5/*

# Image builder tries to chcon even when it doesn't need to
RUN printf '#!/bin/sh\nexit 0\n' > /usr/bin/chcon && chmod +x /usr/bin/chcon

COPY ./storage.conf /etc/containers/storage.conf


RUN LATEST_VERSION=$(curl https://api.github.com/repos/sigstore/cosign/releases/latest | grep tag_name | cut -d : -f2 | tr -d "v\", "); \
    curl -O -L "https://github.com/sigstore/cosign/releases/latest/download/cosign-${LATEST_VERSION}-1.x86_64.rpm"; \
    rpm -ivh cosign-${LATEST_VERSION}-1.x86_64.rpm
